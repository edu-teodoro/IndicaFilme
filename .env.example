# Environment template for local/dev/prod deploy
# Copy to .env only in local development. Never commit real secrets

# Application
SERVER_PORT=1533
LOG_LEVEL=INFO
SWAGGER_ENABLED=false
CORS_ORIGINS=

# MongoDB (required in production)
MONGODB_URI=

# Admin API Key (required)
# Generate a unique secret for each environment; never reuse an exposed key.
ADMIN_API_KEY=

# TMDB integration (optional)
TMDB_API_KEY=

# Used by the local profile; production keeps MongoDB as the persistence backend.
FALLBACK_LOCAL_ENABLED=false
