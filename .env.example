# Environment template for local/dev/prod deploy
# Copy to .env only in local development. Never commit real secrets

# Application
SERVER_PORT=1533
LOG_LEVEL=INFO
SWAGGER_ENABLED=false
CORS_ORIGINS=

# MongoDB (required in production)
MONGO_URI=

# Admin API Key (required)
ADMIN_API_KEY=

# TMDB integration (optional)
TMDB_API_KEY=

# safety switch
# false = production behavior (fail if Mongo is unavailable)
# true = local development fallback in memory
LOCAL_FALLBACK_ENABLED=false
